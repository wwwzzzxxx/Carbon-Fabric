#version 430 core
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Source { uint source[]; };
layout(std430, binding = 1) writeonly buffer Target { uint target[]; };
uniform uint Count;
uniform float Clock;
uniform float GroundScaleY;
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= Count) return;
    uint offset = index * 10u;
    float age = Clock + uintBitsToFloat(source[offset + 4u]);
    float phase = uintBitsToFloat(source[offset + 5u]);
    float angle = age / 20.0 + phase;
    float s = sin(angle), c = cos(angle);
    vec3 copy = vec3(uintBitsToFloat(source[offset + 6u]), uintBitsToFloat(source[offset + 7u]), uintBitsToFloat(source[offset + 8u]));
    vec3 position = vec3(uintBitsToFloat(source[offset]), uintBitsToFloat(source[offset + 1u]), uintBitsToFloat(source[offset + 2u]));
    position += vec3(c * copy.x + s * copy.z, copy.y, -s * copy.x + c * copy.z);
    position.y += 0.25 * GroundScaleY;
    if (uintBitsToFloat(source[offset + 9u]) != 0.0) position.y += sin(age / 10.0 + phase) * 0.1 + 0.1;
    target[offset] = floatBitsToUint(position.x);
    target[offset + 1u] = floatBitsToUint(position.y);
    target[offset + 2u] = floatBitsToUint(position.z);
    target[offset + 3u] = source[offset + 3u];
    target[offset + 4u] = floatBitsToUint(s);
    target[offset + 5u] = floatBitsToUint(c);
    for (uint i = 6u; i < 10u; i++) target[offset + i] = 0u;
}
